from collections import deque

R,C=map(int,input().split())
sy,sx=map(lambda x:int(x)-1,input().split())
gy,gx=map(lambda x:int(x)-1,input().split())

Map=[]
for _ in range(R):
    Map.append(list(input()))

dist=[[-1]*C for _ in range(R)]

dist[sy][sx]=0
queue=deque([(sy,sx)])
while queue:
    ynow,xnow=queue.popleft()
    for (y,x) in ((1,0),(0,1),(-1,0),(0,-1)):
        if dist[ynow+y][xnow+x]==-1 and Map[ynow+y][xnow+x]==".":
            queue.append((ynow+y,xnow+x))
            dist[ynow+y][xnow+x]=dist[ynow][xnow]+1
            
print(dist[gy][gx])
    



