N,W=map(int,input().split())
w=[]
v=[]
for i in range(N):
    wi,vi=map(int,input().split())
    w.append(wi)
    v.append(vi)

dp=[[0]*(W+1) for _ in range(N+1)]


for i in range(1,N+1):
    for wnow in range(W+1):
        if w[i-1]>wnow:
            dp[i][wnow]=dp[i-1][wnow]
        else:
            dp[i][wnow]=max(dp[i-1][wnow],(dp[i-1][wnow-w[i-1]]+v[i-1]))

print(max(dp[N]))

