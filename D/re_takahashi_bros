import heapq

N=int(input())

graph=[[] for _ in range(N+1)]

for i in range(1,N):
    a,b,x=map(int,input().split())
    graph[i].append((i+1,a))
    graph[i].append((x,b))

INF=float('inf')
cost=[INF]*(N+1)
cost[1]=0


hq=[(0,1)]    #cost,stage

while hq:

    current_cost,u=heapq.heappop(hq)
    if current_cost>cost[u]:
        continue
    
    for v,weight in graph[u]:
        new_cost=current_cost+weight
        if new_cost<cost[v]:
            cost[v]=new_cost
            heapq.heappush(hq,(new_cost,v))

print(cost[N])

